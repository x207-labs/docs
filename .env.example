# Server-side only. Never prefix with NEXT_PUBLIC_.
# Without WUSROUTER_API_KEY the Ask AI panel shows "AI assistant is not configured."
WUSROUTER_API_KEY=
# Optional: chat model id from https://wusrouter.com/api/v1/models (default: deepseek-v4-flash)
X207_DOCS_AI_MODEL=
# Optional: extra allowed origins for /api/chat, comma-separated (same host is always allowed)
X207_DOCS_ALLOWED_ORIGINS=
