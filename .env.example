# Server-side only. Never prefix with NEXT_PUBLIC_.
# Without XKIRO_API_KEY the Ask AI panel shows "AI assistant is not configured."
# Key from https://docs.xkiro.com (quick start).
XKIRO_API_KEY=
# Optional: chat model ids from https://api.xkiro.com/v1/models, comma separated, tried in order
# (default: mistralai/mistral-medium-3.5,mistralai/mistral-large-2512,cohere/command-a-plus,cohere/command-a, all free tier)
X207_DOCS_AI_MODEL=
# Optional: extra allowed origins for /api/chat, comma-separated (same host is always allowed)
X207_DOCS_ALLOWED_ORIGINS=
